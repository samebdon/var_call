process {
    executor = 'lsf'
    queue = 'normal'
    cache = 'lenient'

    withName: FREEBAYES_PARALLEL {
        cpus = 8
        memory = '32 GB'
        errorStrategy = 'retry'
        maxRetries = 1
        queue = { task.attempt == 1 ? 'week' : 'basement' }
    }

    withName: 'BWA_MEM|BWA_MEM_SE|BWA_MEM_CRAM|BWA_MEM_SE_CRAM' {
        errorStrategy = 'retry'
        maxRetries = 2
        queue = {
            task.attempt == 1 ? 'normal' :
            task.attempt == 2 ? 'long' :
            'week'
        }
        cpus = 4
        memory = '8 GB'
    }
}

executor {
    perJobMemLimit = true
}
