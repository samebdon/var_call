process {
    executor = 'lsf'
    queue = 'normal'
    cache = 'lenient'

    withName: FREEBAYES_PARALLEL {
        cpus = 8
        memory = '32 GB'
        errorStrategy = 'retry'
        maxRetries = 1
        queue = { task.attempt == 1 ? 'week' : 'basement' }
    }

    withName: 'MINIBWA_MAP|MINIBWA_MAP_SE|MINIBWA_MAP_CRAM|MINIBWA_MAP_SE_CRAM' {
        errorStrategy = 'retry'
        maxRetries = 2
        queue = {
            task.attempt == 1 ? 'normal' :
            task.attempt == 2 ? 'long' :
            'week'
        }
        cpus = 4
        memory = {
            task.attempt == 1 ? 8.GB :
            task.attempt == 2 ? 16.GB :
            32.GB
        }
    }

    withName: 'READS_CRAM_TO_FASTQ_PAIRED|READS_CRAM_TO_FASTQ_SINGLE' {
        errorStrategy = 'retry'
        maxRetries = 2
        queue = {
            task.attempt == 1 ? 'normal' :
            task.attempt == 2 ? 'long' :
            'week'
        }
        cpus = 4
        memory = {
            task.attempt == 1 ? 8.GB :
            task.attempt == 2 ? 16.GB :
            32.GB
        }
    }
}

executor {
    perJobMemLimit = true
}
