process {
    executor = 'lsf'
    queue = 'normal'
    cache = 'lenient'

    withName: FREEBAYES_PARALLEL {
        queue = 'week'
        cpus = 8
        memory = '32 GB'
    }

    withName: 'BWA_MEM' {
        queue = 'long'
        cpus = 4
        memory = '8 GB'
    }

    withName: 'BWA_MEM_SE' {
        queue = 'long'
        cpus = 4
        memory = '8 GB'
    }

    withName: 'BWA_MEM_CRAM' {
        queue = 'long'
        cpus = 4
        memory = '8 GB'
    }

    withName: 'BWA_MEM_SE_CRAM' {
        queue = 'long'
        cpus = 4
        memory = '8 GB'
    }
}

executor {
    perJobMemLimit = true
}
