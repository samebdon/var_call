process {
    cpus = 2
    memory = '4 GB'
    errorStrategy = 'terminate'
    maxRetries = 1

    // Indexing uses roughly 18 bytes per reference base.
    withName: 'MINIBWA_INDEX' {
        cpus = 4
        memory = '64 GB'
    }

    withLabel: 'reads_prep' {
        cpus = 4
        memory = '4 GB'
    }

    withLabel: 'callable_depth' {
        cpus = 4
        memory = '24 GB'
    }

    withLabel: 'variant_calling' {
        cpus = 8
        memory = '32 GB'
    }

}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}
